-- =========================
-- SEND API
-- =========================
local function SendAPI(payload)
    request({
        Url = API_URL,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = HttpService:JSONEncode(payload)
    })
end

-- =========================
-- TIME / MOON
-- =========================
local function getClock()
    return math.floor(Lighting.ClockTime)
end

local function isnight()
    local t = math.floor(Lighting.ClockTime)
    return (t >= 18 or t < 5)
end

local function isrealmoon()
    return (math.floor(Lighting.ClockTime) >= 12 or math.floor(Lighting.ClockTime) < 5)
end

local function getfm()
    if Lighting:GetAttribute("MoonPhase") == 5 and (getClock() >= 12 or getClock() < 5) then
        return "Full Moon"
    elseif Lighting:GetAttribute("MoonPhase") == 4 then
        return "Next Night"
    else
        return "Bad Moon"
    end
end

-- =========================
-- BASIC CHECKS
-- =========================
local function getmirage()
    return Workspace.Map:FindFirstChild("MysticIsland") ~= nil
end

local function getLegHaki()
    local Haki = game.ReplicatedStorage.Remotes.CommF_:InvokeServer("ColorsDealer", "1")

    if Haki == "Snow White"
    or Haki == "Pure Red"
    or Haki == "Winter Sky" then
        return Haki
    end

    return nil
end
local function getelite()
    if ReplicatedStorage:FindFirstChild("Deandre") then
        return "Deandre"
    elseif ReplicatedStorage:FindFirstChild("Urban") then
        return "Urban"
    elseif ReplicatedStorage:FindFirstChild("Diablo") then
        return "Diablo"
    end

    return nil
end





local function berry()
    local bushes = CollectionService:GetTagged("BerryBush")

    for _, bush in pairs(bushes) do
        local attrs = bush:GetAttributes()

        for _, value in pairs(attrs) do
         if value == "White Cloud Berry" or value == "Red Cherry Berry" or value == "Pink Pig Berry" then
 return value
end
        end
    end
end

-- =========================
-- BOSS CHECK
-- =========================
local RareBosses = {
    "rip_indra True Form",
    "Darkbeard",
    "Dough King",
    "Soul Reaper"
}

local function HaveRareBoss(name)
    for _, obj in pairs(game:GetService("ReplicatedStorage"):GetChildren()) do
        if string.find(obj.Name, name) then return true end
    end

    for _, enemy in pairs(Workspace.Enemies:GetChildren()) do
        if string.find(enemy.Name, name) then return true end
    end

    return false
end

-- =========================
-- LEG NPC
-- =========================
local function havelegnpc()
    local npc = Workspace:FindFirstChild("NPCs")
    if npc and npc:FindFirstChild("Legendary Sword Dealer ") then
        return true
    end

    local rep = game:GetService("ReplicatedStorage"):FindFirstChild("NPCs")
    if rep and rep:FindFirstChild("Legendary Sword Dealer ") then
        return true
    end

    return false
end

-- =========================
-- ANTI SPAM MEMORY
-- =========================
local sent = {}

local function SendEvent(eventType, extra)
    if sent[eventType] then return end
    sent[eventType] = true

    SendAPI({
    
Player = #Players:GetPlayers() .. "/" .. Players.MaxPlayers,
        ClockTime = getClock(),
        IsNight = isnight(),
        Moon = getfm(),
        PlaceID = game.PlaceId,
        Sea = Sea,
        Type = eventType,
        Extra = extra,
        JobId = tostring(game.JobId),
    })

    print("📡 SENT:", eventType)
end

-- =========================
-- RESET MEMORY WHEN EVENT DISAPPEARS
-- =========================
local function ResetIfGone(condition, key)
    if not condition then
        sent[key] = false
    end
end

